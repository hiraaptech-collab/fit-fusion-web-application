# FitFusion Environment Configuration
# Copy this file to .env and fill in your values
# NEVER put a real API key in this file — it is tracked by version control.

# Groq AI API Configuration
# Uses OpenAI-compatible API at https://api.groq.com/openai
AI_API_KEY=YOUR_GROQ_API_KEY_HERE
AI_BASE_URL=https://api.groq.com/openai
AI_MODEL=openai/gpt-oss-20b

# WhatsApp Contact Number (international format with country code, no + or spaces)
WHATSAPP_NUMBER=923103701543

# Server Port
PORT=3000
